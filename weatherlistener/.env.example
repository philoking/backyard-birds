# weatherlistener configuration.
# Copy to `.env` and fill in. This file is host-only and gitignored.

# --- Database (TimescaleDB / Postgres) — REQUIRED ---------------------------
# Same database the rest of the system uses. Either set the discrete PG* vars
# below, or a single DATABASE_URL (which takes precedence).
PGHOST=192.168.1.10
PGPORT=5432
PGUSER=tsdbadmin
PGPASSWORD=
PGDATABASE=birdlistener
# DATABASE_URL=postgresql://user:password@host:5432/birdlistener

# --- WeatherFlow Tempest cloud token (OPTIONAL) -----------------------------
# Only needed for the one-off historical backfill
# (`docker compose run --rm weatherlistener python -m scripts.backfill`).
# Live ingest over UDP needs no token. Get a personal access token at:
# https://tempestwx.com/account
TEMPEST_TOKEN=

# --- Optional overrides ------------------------------------------------------
# UDP port the Tempest hub broadcasts on (default 50222).
# TEMPEST_UDP_PORT=50222
