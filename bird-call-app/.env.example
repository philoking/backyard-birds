# bird-call-app (dashboard) configuration.
# Copy to `.env` and fill in. This file is host-only and gitignored.

# --- Database (TimescaleDB / Postgres) — REQUIRED ---------------------------
# The same database birdlistener/weatherlistener write to. Needs read access,
# plus write for the false-positive flag/dismiss actions.
PGHOST=192.168.1.10
PGPORT=5432
PGUSER=tsdbadmin
PGPASSWORD=
PGDATABASE=birdlistener

# --- eBird API (OPTIONAL) ---------------------------------------------------
# Enables the "Reported nearby" panel on species pages and the eBird-driven
# review queue on /flagged. Without a key those features simply don't render.
# Get a free key (registered eBird account): https://ebird.org/api/keygen
EBIRD_API_KEY=

# Station coordinates for eBird "nearby" lookups — REQUIRED for eBird features
# (no location is baked into the code). Set to your station, e.g.:
EBIRD_LAT=
EBIRD_LNG=

# --- xeno-canto API (OPTIONAL) ----------------------------------------------
# Enables the reference-recording player on species pages. Hidden without a key.
# Get a key from your account: https://xeno-canto.org/account
XENOCANTO_KEY=

# --- iNaturalist (OPTIONAL) -------------------------------------------------
# iNaturalist place id, used to show local establishment-means (native /
# introduced) on species pages. Bird photos + summaries work without it.
INAT_PLACE_ID=

# Note: APP_TZ (dashboard timezone), NODE_ENV, and BIRD_CACHE_DIR are set in
# docker-compose.yml, not here. To change the timezone, set APP_TZ in the
# environment compose runs in (or edit docker-compose.yml).
